# Vercel — copy from .env.example (Dashboard → Settings → Environment Variables)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

NOTIFY_EMAIL=
RESEND_API_KEY=

CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_MODE=production

NEXT_PUBLIC_CASHFREE_ENABLED=true
NEXT_PUBLIC_CASHFREE_MODE=production

# Admin panel — Clerk user id(s), comma-separated (same values in both)
ADMIN_CLERK_USER_IDS=
NEXT_PUBLIC_ADMIN_CLERK_USER_IDS=

# Canonical site URL for sitemap, robots.txt, and Open Graph (production)
NEXT_PUBLIC_SITE_URL=https://prizma.guru

# Optional — Vercel sets https return URL automatically from VERCEL_URL (no need to add for counselling payment)
# PUBLIC_APP_URL=https://prizma.guru

# Supabase: run supabase/counselling-setup.sql once (counselling payment + dashboard bookings)

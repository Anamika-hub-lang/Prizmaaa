# Supabase (required for live sync)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Clerk (required for auth)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Server-only — dev API (role + profile sync + webhooks). Never prefix with VITE_
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Supabase service role — server-only for Clerk → profiles sync
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Mentor application emails (server-only)
NOTIFY_EMAIL=aaniya1985@gmail.com
RESEND_API_KEY=re_...

# Cashfree (server secret — never VITE_)
CASHFREE_CLIENT_ID=your_sandbox_or_prod_client_id
CASHFREE_CLIENT_SECRET=your_client_secret
CASHFREE_MODE=sandbox

# Public https URL for Cashfree return_url (required for production keys on localhost — use ngrok or your deployed site)
# PUBLIC_APP_URL=https://your-domain.com

# Client — Cashfree checkout
VITE_CASHFREE_ENABLED=true
VITE_CASHFREE_MODE=production

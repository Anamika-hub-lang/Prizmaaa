    p,li,a,span,div,strong,small,td,th,sub,sup,label {font-family: 'Source Sans Pro', 'Arial', sans-serif;}
    .enq-form-card-container {
            position: relative;
            width: 100%;
            max-width: 440px;
            z-index: 1;
        }

        .enq-blue-backdrop {
            position: absolute;
            inset: 2px; 
            background-color: #012E55;
            border-radius: 40px;
            z-index: -2;
            
        }

        .enq-form-card-container::after {
            content: '';
            position: absolute;
            top: 12px;
            left: 12px;
            right: -12px;
            bottom: -12px;
            border: 1px solid rgba(1, 46, 85, 0.1); /* Adjusted for white bg context */
            border-radius: 24px;
            z-index: -3;
        }

        .enq-main-form-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border-radius: 24px;
            border: 1px solid rgba(255, 255, 255, 0.4);
            box-shadow: 
                0 25px 50px -12px rgba(0, 0, 0, 0.35),
                inset 0 1px 0 rgba(255, 255, 255, 0.6);
            
            overflow: hidden;
            position: relative;
            z-index: 2; 
        }

        .accent-strip {
            height: 6px;
            background: linear-gradient(90deg, #FF5F19, #ff8a54);
            width: 100%;
            box-shadow: 0 2px 10px rgba(255, 95, 25, 0.3);
        }

        .enq-form-card-header {
            padding: 32px 28px 0px 28px;
            text-align: left;
            border-bottom: 1px solid rgba(1, 46, 85, 0.06);
            background: transparent; 
        }

        .enq-form-header-title {
            color: #012E55 !important;
            font-size: 26px !important;
            font-weight: 700 !important;
            margin-bottom: 6px;
            letter-spacing: -0.5px;
            text-shadow: 0 2px 4px rgba(255,255,255,0.5);
            font-family: 'Zilla Slab', serif !important;
        }

        .enq-form-header-subtitle {
            color: #475569;
            font-size: 15px;
            font-weight: 500;
        }

        .enq-form-wrapper {
            background: transparent;
            padding: 20px;
            position: relative;
            /* min-height: 540px; */
        }

        .iframe-container-inner {
            background: #F2F2F2;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: inset 0 2px 4px rgba(0,0,0,0.03); 
            border: 1px solid rgba(1, 46, 85, 0.05);
        }

        h2{
            text-transform:capitalize !important;
        }
.premium-accordion-section {
    padding: 20px 0;
    background: #f8f9fa;
}

.premium-accordion-section .section-title {
    font-size: 2.4rem;
    font-weight: 700;
    margin-bottom: 50px;
    color: #0e395c;
}

.premium-accordion {
    max-width: 1100px !important;
    margin: 0 auto !important;
}

.premium-accordion-item {
    margin-bottom: 18px !important;
    overflow: hidden !important;
    background: #fff !important;
    border-radius: 14px !important;
    border: 1px solid #e5e7eb !important;
    box-shadow: 0 10px 25px rgba(0, 0, 0, .04) !important;
}

.premium-accordion-header {
    width: 100% !important;
    background: transparent !important;
    border: none !important;
    padding: 22px 26px !important;
    font-size: 1.1rem !important;
    font-weight: 600 !important;
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    cursor: pointer !important;
    color: #0e395c !important;
    transition: background .3s !important;
}

.premium-accordion-header h3 {
    margin: 0 !important;
    font-size: 1.1rem !important;
    font-weight: 700 !important;
}

.premium-accordion-header:hover {
    background: #f3f5f7 !important;
}

.premium-accordion-header .icon {
    font-size: 1.5rem !important;
    font-weight: 300 !important;
    transition: transform .3s ease !important;
}

.premium-accordion-body .content-wrapper {
    padding: 26px !important;
    font-size: 1rem !important;
    line-height: 1.7 !important;
    color: #444 !important;
}

.premium-accordion-header[aria-expanded="true"] .icon {
    transform: rotate(45deg) !important;
}

.text-justify {
    text-align: justify !important;
}

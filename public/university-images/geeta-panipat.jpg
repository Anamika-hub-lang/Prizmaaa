<script>
document.querySelectorAll('.toggle-footer').forEach(btn => {
    btn.addEventListener('click', function () {
        const list = this.previousElementSibling;
        const items = list.querySelectorAll('.extra-item');

        const isHidden = items[0].classList.contains('d-none');

        // Toggle list items
        items.forEach(item => item.classList.toggle('d-none'));

        // ✅ Toggle open class on parent
        this.classList.toggle('open', isHidden);
    });
});
</script>




<style>
/* Footer toggle arrow container */
.toggle-footer {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 8px;
    width: 100%;
    cursor: pointer;
}

/* Arrow icon */
.toggle-footer .arrow-icon {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background-color: #f0f4f8;
    color: #06355f;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    transition: transform 0.3s ease, background-color 0.3s ease;
}

/* Rotate when open */
.toggle-footer.open .arrow-icon {
    transform: rotate(180deg);
}

/* Hover */
.toggle-footer:hover .arrow-icon {
    background-color: #06355f;
    color: #ffffff;
}


</style>


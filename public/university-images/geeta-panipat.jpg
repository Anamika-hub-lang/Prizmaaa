    <style>
        .typing-text {
            overflow: hidden;
            white-space: nowrap;
            border-right: 2px solid #012B53;
            width: 0;
            font-weight: 600;
            color: #012B53;

            animation: typingLoop 6s steps(40, end) infinite,
                blink 0.7s infinite;
        }

        /* Typing + Deleting loop */
        @keyframes typingLoop {
            0% {
                width: 0
            }

            40% {
                width: 100%
            }

            /* typing */
            60% {
                width: 100%
            }

            /* pause */
            100% {
                width: 0
            }

            /* deleting */
        }

        /* Cursor blink */
        @keyframes blink {
            50% {
                border-color: transparent
            }
        }
    </style>


<script>
document.addEventListener("DOMContentLoaded", function () {

    function lazyYoutubeModal(modalId, containerId, videoUrl) {

        const modal = document.getElementById(modalId);
        if (!modal) return;

        modal.addEventListener("shown.bs.modal", function () {

            const container = document.getElementById(containerId);
            if (!container) return;

            if (!container.querySelector("iframe")) {
                container.innerHTML =
                    '<iframe width="100%" height="100%" ' +
                    'src="' + videoUrl + '?autoplay=1" ' +
                    'allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" ' +
                    'allowfullscreen></iframe>';
            }
        });

        modal.addEventListener("hidden.bs.modal", function () {
            const container = document.getElementById(containerId);
            if (container) container.innerHTML = "";
        });
    }

    // Apply to both modals
    lazyYoutubeModal("videoModal", "videoIframeContainer", "https://www.youtube.com/embed/arnFS6rf454");
    lazyYoutubeModal("starVideoModal", "starVideoIframeContainer", "https://www.youtube.com/embed/D-TW0dcqMDA");

});
</script>

            

    <script>
        const starVideoModal = document.getElementById('starVideoModal');
        const starVideoIframe = document.getElementById('starVideoIframe');
        const iframeSrc = starVideoIframe.src;

        starVideoModal.addEventListener('hidden.bs.modal', () => {
            starVideoIframe.src = '';
            starVideoIframe.src = iframeSrc;
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var myModal = new bootstrap.Modal(document.getElementById('loadingPopup'));
            myModal.show();
        });
    </script>
    <script>
        const videoModal = document.getElementById("videoModal");
        videoModal.addEventListener("hidden.bs.modal", function () {
            const videoIframe = document.getElementById("videoIframe");
            videoIframe.src = videoIframe.src;
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const widgetBox = document.querySelector(".enq-form-card-container");
            if (!widgetBox) return;

            const observer = new IntersectionObserver((entries, observer) => {
                if (entries[0].isIntersecting) {

                    const s = document.createElement("script");
                    s.src = "https://widgets.in6.nopaperforms.com/emwgts.js";
                    s.async = true;
                    document.body.appendChild(s);

                    observer.disconnect();
                }
            }, {
                rootMargin: "200px"
            });

            observer.observe(widgetBox);

        });
    </script>


    <script type="text/javascript">
        setTimeout(function () {
            var npf_d = "https://admissions.geetauniversity.edu.in/";
            var npf_c = "6438";
            var npf_m = "1";

            var s = document.createElement("script");
            s.type = "text/javascript";
            s.async = true;
            s.src = "https://track.nopaperforms.com/js/track.js";
            document.body.appendChild(s);
        }, 5000);
    </script>

    <script>
        document.getElementById('readMoreBtn').addEventListener('click', function () {
            var text = document.getElementById('readMoreText');
            text.classList.toggle('show');
            this.textContent = text.classList.contains('show') ? 'Read Less' : 'Read More';
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            function animateCounter(el, duration = 1800) {
                const target = parseInt(el.dataset.target, 10);
                const suffix = el.dataset.suffix || "";

                if (isNaN(target)) {
                    return;
                }

                const startTime = performance.now();

                function update(now) {
                    const progress = Math.min((now - startTime) / duration, 1);
                    const eased = 1 - Math.pow(1 - progress, 3);

                    const value = Math.floor(eased * target);
                    el.textContent = value.toLocaleString() + suffix;

                    if (progress < 1) {
                        requestAnimationFrame(update);
                    } else {
                        el.textContent = target.toLocaleString() + suffix;
                    }
                }

                requestAnimationFrame(update);
            }

            const observer = new IntersectionObserver(entries => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        animateCounter(entry.target);
                        observer.unobserve(entry.target);
                    }
                });
            }, {
                threshold: 0.5
            });

            document.querySelectorAll(".counter").forEach(el => observer.observe(el));

        });
    </script>
    <script>
        document.querySelectorAll('.drag-layer').forEach(layer => {
            let isDown = false;
            let startY = 0;
            let currentY = 0;

            layer.addEventListener('mousedown', e => {
                isDown = true;
                startY = e.clientY;
                layer.parentElement.style.animationPlayState = 'paused';
            });

            document.addEventListener('mousemove', e => {
                if (!isDown) return;
                const delta = e.clientY - startY;
                layer.style.transform = `translateY(${currentY + delta}px)`;
            });

            document.addEventListener('mouseup', () => {
                if (!isDown) return;
                currentY += event.clientY - startY;
                isDown = false;
                layer.parentElement.style.animationPlayState = 'running';
            });

            /* Mobile */
            layer.addEventListener('touchstart', e => {
                startY = e.touches[0].clientY;
                layer.parentElement.style.animationPlayState = 'paused';
            });

            layer.addEventListener('touchmove', e => {
                const delta = e.touches[0].clientY - startY;
                layer.style.transform = `translateY(${currentY + delta}px)`;
            });

            layer.addEventListener('touchend', () => {
                currentY = parseFloat(
                    getComputedStyle(layer).transform.split(',')[5]
                ) || 0;
                layer.parentElement.style.animationPlayState = 'running';
            });
        });
    </script>

    <script>
        const popup = document.getElementById("popupOverlay");
        const popupClose = document.getElementById("popupClose");

        // Show popup on every reload
        window.addEventListener("load", () => {
            popup.classList.remove("geeta-popup-hidden");
        });

        // Close on X click
        popupClose.addEventListener("click", () => {
            popup.classList.add("geeta-popup-hidden");
        });

        // Close on outside click
        popup.addEventListener("click", (e) => {
            if (e.target === popup) {
                popup.classList.add("geeta-popup-hidden");
            }
        });
    </script>

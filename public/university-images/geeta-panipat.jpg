    <section class="container py-5 join_gu">
        <div class="text-center px-4">
            <h2 class="display-6 fw-bold">Why Join Geeta University?</h2>
        </div> <!-- Accordion Section -->
        <div class="row mt-5 px-md-4">
            <div class="col-12 col-md-6">
                <div class="accordion" id="whyJoinAccordion">
                    <div class="accordion-border join-geeta">
                        <h2 class="accordion-header" id="headingOne"> <button class="accordion-button" type="button"
                                data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true"
                                aria-controls="collapseOne">Outcome-Based Education (OBE)</button></h2>
                        <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne"
                            data-bs-parent="#whyJoinAccordion">
                            <div class="accordion-body">Outcome-based education focuses on measurable student performance
                                through outcomes such as knowledge, skills, and attitudes.</div>
                        </div>
                    </div> <!-- Digitally Enabled Campus -->
                    <div class="accordion-border join-geeta">
                        <h2 class="accordion-header" id="headingTwo"><button class="accordion-button collapsed"
                                type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false"
                                aria-controls="collapseTwo">Digitally Enabled Campus</button></h2>
                        <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo"
                            data-bs-parent="#whyJoinAccordion">
                            <div class="accordion-body">A campus equipped with cutting-edge digital tools and resources for
                                an enhanced learning experience. </div>
                        </div>
                    </div> <!-- Industry-Collaborated Curriculum -->
                    <div class="accordion-border join-geeta">
                        <h2 class="accordion-header" id="headingThree"> <button class="accordion-button collapsed"
                                type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree"
                                aria-expanded="false" aria-controls="collapseThree">Industry-Collaborated
                                Curriculum</button> </h2>
                        <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree"
                            data-bs-parent="#whyJoinAccordion">
                            <div class="accordion-body"> Learn through curricula developed in collaboration with industry
                                leaders, ensuring job readiness. </div>
                        </div>
                    </div> <!-- Interdisciplinary Research Labs -->
                    <div class="accordion-border join-geeta">
                        <h2 class="accordion-header" id="headingFour"> <button class="accordion-button collapsed"
                                type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour" aria-expanded="false"
                                aria-controls="collapseFour"> Interdisciplinary Research Labs
                            </button> </h2>
                        <div id="collapseFour" class="accordion-collapse collapse" aria-labelledby="headingFour"
                            data-bs-parent="#whyJoinAccordion">
                            <div class="accordion-body"> State-of-the-art research facilities for innovative
                                interdisciplinary projects. </div>
                        </div>
                    </div> <!-- Skill Enhancement Certifications -->
                    <div class="accordion-border join-geeta">
                        <h2 class="accordion-header" id="headingFive"> <button class="accordion-button collapsed"

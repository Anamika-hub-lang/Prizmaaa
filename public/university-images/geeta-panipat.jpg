    <script>
(function () {
  function loadNPFTrack() {
    if (window.__NPF_TRACK_LOADED__) return;
    window.__NPF_TRACK_LOADED__ = true;

    window.npf_d = 'https://admissions.geetauniversity.edu.in';
    window.npf_c = '6438';
    window.npf_m = '1';

    const s = document.createElement("script");
    s.src = "https://track.nopaperforms.com/js/track.js";
    s.async = true;
    document.body.appendChild(s);
  }

  if ("requestIdleCallback" in window) {
    requestIdleCallback(loadNPFTrack, { timeout: 5000 });
  } else {
    setTimeout(loadNPFTrack, 4000);
  }
})();
</script>
<style>
